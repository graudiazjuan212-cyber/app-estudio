{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema": {
      "type": "string",
      "const": "estudio-progreso/1"
    },
    "exportado": {
      "type": "string",
      "format": "date-time",
      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))T(?:(?:[01]\\d|2[0-3]):[0-5]\\d:[0-5]\\d(?:\\.\\d+)?(?:Z|([+-](?:[01]\\d|2[0-3]):[0-5]\\d)))$"
    },
    "asignatura": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "pattern": "^[a-z0-9][a-z0-9_-]*$"
    },
    "sesiones": {
      "maxItems": 60,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "fecha": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          },
          "minutos": {
            "type": "number",
            "minimum": 0,
            "multipleOf": 0.1
          },
          "preguntas": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "aciertos": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "tipo": {
            "type": "string",
            "enum": [
              "estudio",
              "repaso",
              "examen"
            ]
          }
        },
        "required": [
          "fecha",
          "minutos",
          "preguntas",
          "aciertos",
          "tipo"
        ],
        "additionalProperties": false
      }
    },
    "capitulos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "numero": {
            "type": "integer",
            "exclusiveMinimum": 0,
            "maximum": 9007199254740991
          },
          "titulo": {
            "type": "string"
          },
          "porcentaje": {
            "type": "integer",
            "minimum": 0,
            "maximum": 100
          },
          "bloques": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1,
                  "maxLength": 80,
                  "pattern": "^[a-z0-9][a-z0-9_-]*$"
                },
                "titulo": {
                  "type": "string"
                },
                "peso": {
                  "anyOf": [
                    {
                      "type": "number",
                      "const": 1
                    },
                    {
                      "type": "number",
                      "const": 3
                    },
                    {
                      "type": "number",
                      "const": 5
                    }
                  ]
                },
                "estado": {
                  "type": "string",
                  "enum": [
                    "pendiente",
                    "en_curso",
                    "dominado",
                    "graduado"
                  ]
                },
                "bloqueado": {
                  "type": "boolean"
                },
                "dias_dominio": {
                  "type": "array",
                  "items": {
                    "type": "string",
                    "format": "date",
                    "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                  }
                },
                "proximo_repaso": {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date",
                      "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
                    },
                    {
                      "type": "null"
                    }
                  ]
                }
              },
              "required": [
                "id",
                "titulo",
                "peso",
                "estado",
                "bloqueado",
                "dias_dominio",
                "proximo_repaso"
              ],
              "additionalProperties": false
            }
          }
        },
        "required": [
          "id",
          "numero",
          "titulo",
          "porcentaje",
          "bloques"
        ],
        "additionalProperties": false
      }
    },
    "puntos_ciegos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "enunciado_corto": {
            "type": "string",
            "maxLength": 81
          },
          "fecha": {
            "type": "string",
            "format": "date",
            "pattern": "^(?:(?:\\d\\d[2468][048]|\\d\\d[13579][26]|\\d\\d0[48]|[02468][048]00|[13579][26]00)-02-29|\\d{4}-(?:(?:0[13578]|1[02])-(?:0[1-9]|[12]\\d|3[01])|(?:0[469]|11)-(?:0[1-9]|[12]\\d|30)|(?:02)-(?:0[1-9]|1\\d|2[0-8])))$"
          }
        },
        "required": [
          "item",
          "enunciado_corto",
          "fecha"
        ],
        "additionalProperties": false
      }
    },
    "fallos_recurrentes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "item": {
            "type": "string",
            "minLength": 1,
            "maxLength": 80,
            "pattern": "^[a-z0-9][a-z0-9_-]*$"
          },
          "enunciado_corto": {
            "type": "string",
            "maxLength": 81
          },
          "fallos": {
            "type": "integer",
            "minimum": 2,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "item",
          "enunciado_corto",
          "fallos"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "schema",
    "exportado",
    "asignatura",
    "sesiones",
    "capitulos",
    "puntos_ciegos",
    "fallos_recurrentes"
  ],
  "additionalProperties": false,
  "description": "Reglas semánticas: aciertos no supera preguntas; minutos tiene un decimal; solo datos de la asignatura; sesiones terminadas con intentos, ordenadas y limitadas a las últimas 60; estados reconstruidos del registro; se excluyen archivados; vencimiento mínimo FSRS; fallos de la generación actual en los últimos 30 días de estudio; textos abreviados a 80 caracteres más elipsis."
}
